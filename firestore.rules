rules_version = '2';

// Reglas mínimas de Fase 1 (SPEC_02 §10): cada persona ve solo su árbol.
// Nada más entra aquí. La validación de forma de los datos vive en
// src/lib/db/schema.js, no en el servidor.
//
// RN-DB-04 — `diario/pinConfig`, `shared/frases` y `diario/frasesDelDia` no
// aparecen en ninguna regla porque nunca se sincronizan: no salen del
// dispositivo (`esRutaLocal`).
//
// SPEC_24 — Borrar la cuenta borra el árbol desde la app (DP-24.4 = A): la
// misma regla de arriba deja a cada uid borrar lo suyo, y a nadie más.

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
