{
  "name": "strivo",
  "version": "0.1.0",
  "private": true,
  "description": "Refugio digital para terminar cada d\u00eda en paz contigo mismo.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --report-unused-disable-directives --max-warnings 0",
    "lint:copy": "node scripts/lint-copy.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{js,jsx}\"",
    "lint:contraste": "node scripts/lint-contraste.js",
    "validar:frases": "node scripts/validar-frases.js",
    "format:check": "prettier --check \"src/**/*.{js,jsx}\"",
    "ios:build": "vite build --mode ios && cap sync ios",
    "ios:abrir": "cap open ios",
    "ios:arranque": "node scripts/componer-arranque.js",
    "ios:recursos": "npx --yes @capacitor/assets@3.0.5 generate --ios"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource-variable/inter": "^5.3.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "firebase": "^10.13.0",
    "idb": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.9.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "fake-indexeddb": "^6.0.0",
    "postcss": "^8.4.41",
    "prettier": "^3.3.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.10",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.20.0",
    "vitest": "^2.0.5"
  }
}
